# Core operation is offline and does not require credentials.
# Default local artifact is OLMoE-1B-7B (1B active parameters), not Qwen3-30B-A3B.
# Configure Qwen3-30B-A3B only after installing a compatible GGUF and confirming
# that the host has enough RAM/VRAM for the selected quantization and context.
LLM_PROVIDER=local
NARRATIVE_LLM_PROVIDER=local
LOCAL_LLM_RUNTIME=llama_cpp
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL_NAME=auto
LOCAL_LLM_MODEL_PATH=models/qwen2.5-0.5b-instruct-q4_k_m.gguf
LOCAL_LLM_CONTEXT_SIZE=4096
LOCAL_LLM_THREADS=4
LOCAL_LLM_GPU_LAYERS=all
LOCAL_LLM_DEVICE=Vulkan0
LOCAL_LLM_TIMEOUT_SECONDS=180
LLAMA_SERVER_EXECUTABLE=llama-server

# Optional hosted narrative model. Leave disabled to use the local LLM.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NARRATIVE_LLM_PROVIDER=local
NARRATIVE_OPENROUTER_MODEL=qwen/qwen3.5-35b-a3b
NARRATIVE_TEMPERATURE=0.75
NARRATIVE_LOCAL_TEMPERATURE=0.7
NARRATIVE_TOP_P=0.8
NARRATIVE_REPEAT_PENALTY=1.05
NARRATIVE_FAST_MODE=true
NARRATIVE_FAST_MAX_OUTPUT_TOKENS=256
NARRATIVE_SCENE_MAX_OUTPUT_TOKENS=256
NARRATIVE_MAX_OUTPUT_TOKENS=256
NARRATIVE_TIMEOUT_SECONDS=180
NARRATIVE_MAX_RETRIES=3
NARRATIVE_MIN_SCENE_WORDS=45
NARRATIVE_MAX_SCENE_WORDS=130
NARRATIVE_REASONING_EFFORT=none
NARRATIVE_PREMIUM_MODEL=qwen/qwen3.5-397b-a17b
NARRATIVE_INPUT_COST_PER_MILLION=0
NARRATIVE_OUTPUT_COST_PER_MILLION=0
NARRATIVE_ALLOW_LOCAL_FALLBACK=false

# Persistent structured narrative memory (SQLite; no vector database required)
NARRATIVE_MEMORY_ENABLED=true
NARRATIVE_MEMORY_RETRIEVAL_LIMIT=12
NARRATIVE_MEMORY_CONTEXT_TOKEN_BUDGET=800
NARRATIVE_MEMORY_MIN_CONFIDENCE=0.70
NARRATIVE_MEMORY_SEMANTIC_ENABLED=false

# Advisory planning; never changes the VQC-selected action
NARRATIVE_PLANNER_ENABLED=true

# Story-scoped secret ledger and fail-closed prose reveal gate
NARRATIVE_SECRET_LEDGER_ENABLED=true
NARRATIVE_REVEAL_GATE_ENABLED=true
NARRATIVE_SECRET_STRICT_VALIDATION=true
NARRATIVE_PLANNER_ENABLED=true

# Optional verified Jev deployment. Never commit real credentials.
JEV_ENABLED=false
JEV_PROVIDER=openrouter
JEV_ENDPOINT=
JEV_MODEL=
JEV_API_KEY=
JEV_TIMEOUT_SECONDS=15
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=AetherScribe

DATABASE_URL=sqlite:///./aetherscribe_lab.db
